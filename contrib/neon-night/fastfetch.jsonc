// Neon Night fastfetch layout: small distro logo, icon keys, color dots.
// Install: mkdir -p ~/.config/fastfetch && cp fastfetch.jsonc ~/.config/fastfetch/config.jsonc
// Icons need a Nerd Font (e.g. "JetBrainsMono Nerd Font") selected in Zephyr › Settings › Fonts.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "cyan" }
  },
  "modules": [
    { "type": "os",       "key": "  ├", "keyColor": "cyan" },
    { "type": "kernel",   "key": "  ├", "keyColor": "green" },
    { "type": "wm",       "key": "  ├", "keyColor": "blue" },
    { "type": "uptime",   "key": "  ├", "keyColor": "yellow" },
    { "type": "packages", "key": "  ├", "keyColor": "magenta" },
    { "type": "memory",   "key": "  ├", "keyColor": "red" },
    { "type": "shell",    "key": "  ╰", "keyColor": "cyan" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
