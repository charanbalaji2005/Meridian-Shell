[Desktop Entry]
Type=Application
Version=1.5
Name=Zephyr Terminal
GenericName=Terminal
Comment=Fast, modern terminal emulator with tabs, splits and profiles
Exec=zephyr-terminal
TryExec=zephyr-terminal
Icon=zephyr-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;prompt;command;commandline;cmd;console;ssh;
StartupNotify=true
StartupWMClass=zephyr-terminal
# How launchers ask this terminal to run a program
# (xdg-terminal-exec / GIO / KDE conventions).
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
X-ExecArg=-e
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=zephyr-terminal --no-restore
