# Zephyr Terminal .gitignore

# Build outputs
build/
bin/
dist/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Zephyr persistent recordings and databases
*.rec
*.db
*.workspace
*.log
test_output.txt

# Distribution packages and archives
*.tar.gz
*.tar.xz
*.rpm
*.deb
*.apk
*.snap
*.flatpak

# Local configuration overrides & secrets
.config/
.cache/
zephyr_credentials.local

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
compile_commands.json
.clangd/
node_modules/
web-docs/node_modules/
.vite/

# CMake / packaging work directories
build-*/
cmake-build-*/
/debian/
*.AppImage
*.pkg.tar.*
AppDir/

# Nix
result
result-*
